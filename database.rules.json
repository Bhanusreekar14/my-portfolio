{
  "rules": {
    "portfolio": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'PEJmKG9mp3ahKo0jL77qVMiGLd42'"
    },
    "messages": {
      ".read": "auth != null && auth.uid === 'PEJmKG9mp3ahKo0jL77qVMiGLd42'",
      ".write": "auth != null && auth.uid === 'PEJmKG9mp3ahKo0jL77qVMiGLd42'",
      "$messageId": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.uid === 'PEJmKG9mp3ahKo0jL77qVMiGLd42')",
        ".validate": "newData.hasChildren(['name', 'email', 'subject', 'message', 'createdAt', 'read'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 100 && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/)"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 5000"
        },
        "createdAt": {
          ".validate": "newData.isString()"
        },
        "read": {
          ".validate": "newData.isBoolean() && (!data.exists() ? newData.val() === false : true)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
